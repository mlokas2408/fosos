#!/bin/sh
# Ensure the live/installed squashfs boots logo+spinner (not a text console).
# fosos-theme postinst also does this; the hook covers image builds where
# dpkg configure order might skip a full initramfs rebuild.
set -eu

if ! command -v plymouth-set-default-theme >/dev/null 2>&1; then
  echo "plymouth-set-default-theme missing; install plymouth in the package list." >&2
  exit 1
fi

if [ ! -f /usr/share/plymouth/themes/fosos/fosos.plymouth ]; then
  echo "FosOS Plymouth theme missing; install fosos-theme before this hook." >&2
  exit 1
fi

if [ ! -f /usr/share/initramfs-tools/modules.d/fosos-kms ]; then
  echo "fosos-kms modules.d drop-in missing from fosos-theme (early KMS)." >&2
  exit 1
fi

if [ ! -f /usr/share/initramfs-tools/hooks/zz-fosos-plymouth ]; then
  echo "zz-fosos-plymouth initramfs hook missing from fosos-theme." >&2
  exit 1
fi

plymouth-set-default-theme -R fosos

# Keys outside [Daemon] are ignored; keep DeviceTimeout high so a slow GPU
# probe does not fall back to the grey three-dot text theme.
conf=/etc/plymouth/plymouthd.conf
if [ -f "$conf" ]; then
  sed -i \
    -e '/^Theme[[:blank:]]*=/d' \
    -e '/^ShowDelay[[:blank:]]*=/d' \
    -e '/^DeviceTimeout[[:blank:]]*=/d' \
    "$conf"
  if grep -qE '^\[Daemon\]' "$conf"; then
    sed -i '/^\[Daemon\]/a Theme=fosos\nShowDelay=0\nDeviceTimeout=45' "$conf"
  else
    printf '\n[Daemon]\nTheme=fosos\nShowDelay=0\nDeviceTimeout=45\n' >>"$conf"
  fi
  update-initramfs -u
fi

if [ ! -f /etc/default/grub.d/fosos-boot.cfg ]; then
  echo "fosos-boot.cfg missing from fosos-theme." >&2
  exit 1
fi
