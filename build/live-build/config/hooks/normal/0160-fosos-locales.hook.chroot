#!/bin/sh
# Generate the UTF-8 locales FosOS Settings → Region lists, plus en_US as the
# default. APT recommends are off, so locales must be installed via the package
# list; this hook ensures they are actually built into the image.
set -eu

if [ ! -f /etc/locale.gen ] || ! command -v locale-gen >/dev/null 2>&1; then
  echo "locales / locale-gen missing; install locales in fosos-base.list.chroot" >&2
  exit 1
fi

locales='
en_US.UTF-8
en_GB.UTF-8
hr_HR.UTF-8
pl_PL.UTF-8
de_DE.UTF-8
fr_FR.UTF-8
es_ES.UTF-8
it_IT.UTF-8
pt_BR.UTF-8
pt_PT.UTF-8
nl_NL.UTF-8
sv_SE.UTF-8
nb_NO.UTF-8
da_DK.UTF-8
fi_FI.UTF-8
cs_CZ.UTF-8
sk_SK.UTF-8
hu_HU.UTF-8
ro_RO.UTF-8
uk_UA.UTF-8
ru_RU.UTF-8
ja_JP.UTF-8
ko_KR.UTF-8
zh_CN.UTF-8
zh_TW.UTF-8
'

for code in $locales; do
  entry="$code UTF-8"
  esc=$(printf '%s' "$code" | sed 's/[.]/[.]/g')
  if grep -qE "^#[[:space:]]*${esc}[[:space:]]" /etc/locale.gen; then
    sed -i -E "s/^#[[:space:]]*(${esc})[[:space:]].*/${entry}/" /etc/locale.gen
  elif ! grep -qE "^${esc}[[:space:]]" /etc/locale.gen; then
    printf '%s\n' "$entry" >> /etc/locale.gen
  fi
done

locale-gen

if [ ! -f /etc/default/locale ]; then
  printf 'LANG=en_US.UTF-8\n' > /etc/default/locale
fi
