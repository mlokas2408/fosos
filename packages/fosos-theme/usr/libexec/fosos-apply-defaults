#!/bin/sh
# Apply FosOS desktop defaults once. Later changes the user makes are kept.
marker="${XDG_CONFIG_HOME:-$HOME/.config}/fosos/desktop-defaults-applied"
if [ -f "$marker" ]; then
	exit 0
fi

i=0
while [ "$i" -lt 25 ]; do
	if xfconf-query -c xsettings -l >/dev/null 2>&1; then
		break
	fi
	i=$((i + 1))
	sleep 0.2
done

if ! xfconf-query -c xsettings -l >/dev/null 2>&1; then
	exit 0
fi

mkdir -p "$(dirname "$marker")"

set_str() { xfconf-query -c "$1" -p "$2" -n -t string -s "$3" || true; }
set_int() { xfconf-query -c "$1" -p "$2" -n -t int -s "$3" || true; }
set_uint() { xfconf-query -c "$1" -p "$2" -n -t uint -s "$3" || true; }
set_bool() { xfconf-query -c "$1" -p "$2" -n -t bool -s "$3" || true; }

set_str xsettings /Net/ThemeName Greybird
set_str xsettings /Net/IconThemeName elementary-xfce
set_str xsettings /Gtk/FontName "Inter 10"
set_str xsettings /Gtk/MonospaceFontName "Liberation Mono 10"
set_str xsettings /Gtk/CursorThemeName DMZ-White
set_int xsettings /Gtk/CursorThemeSize 24
set_int xsettings /Xft/DPI 96
set_int xsettings /Xft/Antialias 1
set_int xsettings /Xft/Hinting 1
set_str xsettings /Xft/HintStyle hintslight
set_str xsettings /Xft/RGBA rgb

wallpaper=/usr/share/backgrounds/fosos/fosos-wallpaper.png
monitors=$(xfconf-query -c xfce4-desktop -l 2>/dev/null | sed -n 's|^/backdrop/screen0/\([^/]*\)/.*|\1|p' | sort -u || true)
if [ -z "$monitors" ]; then
	monitors="monitor0 monitorVirtual-1"
fi
for mon in $monitors; do
	set_str xfce4-desktop "/backdrop/screen0/${mon}/workspace0/last-image" "$wallpaper"
	set_int xfce4-desktop "/backdrop/screen0/${mon}/workspace0/image-style" 5
done

# Ask before powering off. Close the lid to suspend. Blank, then sleep the display.
set_uint xfce4-power-manager /xfce4-power-manager/power-button-action 3
set_uint xfce4-power-manager /xfce4-power-manager/lid-action-on-ac 1
set_uint xfce4-power-manager /xfce4-power-manager/lid-action-on-battery 1
set_int xfce4-power-manager /xfce4-power-manager/blank-on-ac 15
set_int xfce4-power-manager /xfce4-power-manager/blank-on-battery 5
set_uint xfce4-power-manager /xfce4-power-manager/dpms-on-ac-sleep 20
set_uint xfce4-power-manager /xfce4-power-manager/dpms-on-ac-off 30
set_uint xfce4-power-manager /xfce4-power-manager/dpms-on-battery-sleep 10
set_uint xfce4-power-manager /xfce4-power-manager/dpms-on-battery-off 15
set_bool xfce4-power-manager /xfce4-power-manager/dpms-enabled true

set_int keyboards /Default/KeyRepeat/Delay 400
set_int keyboards /Default/KeyRepeat/Rate 30

touch "$marker"
exit 0
