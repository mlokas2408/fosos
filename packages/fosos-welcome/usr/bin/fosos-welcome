#!/usr/bin/env python3
"""First-login welcome for the FosOS live session and installed system."""

import pathlib
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk

MARKER = pathlib.Path.home() / ".config" / "fosos" / "welcome-done"
GUIDE = "file:///usr/share/doc/fosos/guide.html"


def is_live() -> bool:
    try:
        return "boot=live" in pathlib.Path("/proc/cmdline").read_text(encoding="utf-8")
    except OSError:
        return False


def network_status() -> str:
    try:
        state = subprocess.check_output(
            ["nmcli", "-t", "-f", "CONNECTIVITY", "general"],
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
    except (OSError, subprocess.CalledProcessError):
        return "Network status is unavailable."
    labels = {
        "full": "Connected.",
        "limited": "Connected, with limited reach.",
        "portal": "A network login page may be required.",
        "none": "Not connected.",
        "unknown": "Network status is unknown.",
    }
    return labels.get(state, f"Network status: {state}.")


def open_guide() -> None:
    subprocess.Popen(["firefox-esr", GUIDE])


def finish_setup() -> None:
    MARKER.parent.mkdir(parents=True, exist_ok=True)
    MARKER.write_text("done\n", encoding="utf-8")


class Welcome(Gtk.Window):
    def __init__(self) -> None:
        super().__init__(title="Welcome to FosOS")
        self.set_default_size(520, 320)
        self.set_border_width(24)
        live = is_live()

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.add(box)

        title = Gtk.Label()
        title.set_markup("<span size='x-large' weight='bold'>Welcome to FosOS</span>")
        title.set_halign(Gtk.Align.START)
        box.pack_start(title, False, False, 0)

        if live:
            intro = (
                "This is the live session. Nothing is installed yet. "
                "Firefox is the browser, and Chrome is not included."
            )
        else:
            intro = (
                "This account is ready to use. Firefox is the browser, "
                "and Chrome is not included. Optional software comes from APT."
            )
        body = Gtk.Label(label=intro)
        body.set_line_wrap(True)
        body.set_halign(Gtk.Align.START)
        body.set_xalign(0)
        box.pack_start(body, False, False, 0)

        self.status = Gtk.Label(label=network_status())
        self.status.set_halign(Gtk.Align.START)
        self.status.set_xalign(0)
        box.pack_start(self.status, False, False, 0)

        buttons = Gtk.Box(spacing=8)
        box.pack_end(buttons, False, False, 0)

        guide = Gtk.Button(label="Open the guide")
        guide.connect("clicked", lambda _button: open_guide())
        buttons.pack_start(guide, False, False, 0)

        if live:
            install = Gtk.Button(label="Install FosOS")
            install.get_style_context().add_class("suggested-action")
            install.connect("clicked", self.on_install)
            buttons.pack_end(install, False, False, 0)
            later = Gtk.Button(label="Continue")
            later.connect("clicked", lambda _button: self.destroy())
            buttons.pack_end(later, False, False, 0)
        else:
            updates = Gtk.Button(label="Install updates")
            updates.connect("clicked", self.on_updates)
            buttons.pack_start(updates, False, False, 0)
            done = Gtk.Button(label="Finish setup")
            done.get_style_context().add_class("suggested-action")
            done.connect("clicked", self.on_finish)
            buttons.pack_end(done, False, False, 0)

    def on_install(self, _button: Gtk.Button) -> None:
        subprocess.Popen(["calamares-install-fosos"])
        self.destroy()

    def on_finish(self, _button: Gtk.Button) -> None:
        finish_setup()
        self.destroy()

    def on_updates(self, _button: Gtk.Button) -> None:
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.OK_CANCEL,
            text="Install updates now?",
        )
        dialog.format_secondary_text(
            "FosOS will refresh package lists and install available upgrades. "
            "This needs a network connection and your password."
        )
        response = dialog.run()
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            return
        self.status.set_text("Installing updates…")
        while Gtk.events_pending():
            Gtk.main_iteration()
        result = subprocess.run(
            ["pkexec", "sh", "-c", "apt-get update && apt-get -y upgrade"],
        )
        if result.returncode == 0:
            self.status.set_text("Updates are installed.")
        else:
            self.status.set_text("Updates did not finish. Check the network and try again.")


def main() -> None:
    again = "--again" in sys.argv[1:]
    if MARKER.exists() and not again:
        return
    window = Welcome()
    window.connect("destroy", Gtk.main_quit)
    window.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
