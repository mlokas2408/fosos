#!/bin/sh
# Launch the FosOS installer from the live desktop.
set -eu

if [ -f /etc/fstab ]; then
	sudo mv /etc/fstab /etc/fstab.orig.calamares
fi

restore_fstab() {
	if [ -f /etc/fstab.orig.calamares ]; then
		sudo mv /etc/fstab.orig.calamares /etc/fstab
	fi
}
trap restore_fstab EXIT

xhost +si:localuser:root
set +e
pkexec /usr/libexec/fosos-calamares "$@"
status=$?
set -e
xhost -si:localuser:root || true
exit "$status"
