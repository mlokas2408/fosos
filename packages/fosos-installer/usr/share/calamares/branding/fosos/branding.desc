---
componentName: fosos
welcomeStyleCalamares: true
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 800px,580px
windowPlacement: center

strings:
  productName: FosOS
  shortProductName: FosOS
  version: "0.1"
  shortVersion: "0.1"
  versionedName: FosOS 0.1
  shortVersionedName: FosOS 0.1
  bootloaderEntryName: FosOS
  productUrl: file:///usr/share/doc/fosos/guide.html
  supportUrl: file:///usr/share/doc/fosos/guide.html
  knownIssuesUrl: file:///usr/share/doc/fosos/guide.html
  releaseNotesUrl: file:///usr/share/doc/fosos/guide.html
  donateUrl: file:///usr/share/doc/fosos/guide.html

sidebar: widget
navigation: widget

images:
  productLogo: "welcome.png"
  productIcon: "welcome.png"
  productWelcome: "welcome.png"

# Plain image slideshow (not QML) so the Install step never shows a blank
# white pane if Qt Quick modules fail to load on the live image.
slideshow:
  - slide1.png
  - slide2.png
  - slide3.png
  - slide4.png


style:
  SidebarBackground: "#0a0a0a"
  SidebarText: "#a1a1a1"
  SidebarTextCurrent: "#fafafa"
  SidebarBackgroundCurrent: "#262626"
