#!/bin/sh
# FosOS Desktop session. Fallback: FosOS Recovery via ~/.dmrc, or a
# text console (Ctrl+Alt+F2). See RECOVERY.md.

export XDG_CURRENT_DESKTOP=FosOS
export XDG_SESSION_DESKTOP=fosos-desktop
export DESKTOP_SESSION=fosos-desktop
export GTK_THEME=FosOS
export GTK_ICON_THEME_NAME=FosOS
# Browser Save As / Open uses the FosOS file chooser instead of the stock GTK dialog.
export GTK_USE_PORTAL=1

# Session-only MIME and helper defaults (Files / Terminal).
if [ -z "${XDG_CONFIG_DIRS}" ]; then
	XDG_CONFIG_DIRS="/etc/xdg"
fi
case ":${XDG_CONFIG_DIRS}:" in
*:/etc/xdg/fosos-desktop:*) ;;
*) XDG_CONFIG_DIRS="/etc/xdg/fosos-desktop:${XDG_CONFIG_DIRS}" ;;
esac
export XDG_CONFIG_DIRS

data=/usr/share/fosos-desktop
config="${XDG_CONFIG_HOME:-$HOME/.config}/fosos-desktop"
mkdir -p "$config"

# Create XDG user folders (Documents, Downloads, Pictures, Music, Videos,
# Desktop, …) on first login for every account. FosOS does not run the
# generic XDG autostart list, so call the updater here. LC_MESSAGES=C keeps
# English folder names even when the session locale is localized.
if command -v xdg-user-dirs-update >/dev/null 2>&1; then
	LC_MESSAGES=C.UTF-8 xdg-user-dirs-update >/dev/null 2>&1 || true
fi

# Seed default Desktop launchers (Computer / Files / Recycle Bin) if missing.
if command -v python3 >/dev/null 2>&1; then
	PYTHONPATH="/usr/lib/fosos-desktop${PYTHONPATH:+:$PYTHONPATH}" \
		python3 -c 'from fosdesk.desktop import ensure_default_desktop_entries; ensure_default_desktop_entries()' \
		>/dev/null 2>&1 || true
fi

rc="$data/openbox/rc.xml"
if [ -f "$config/openbox/rc.xml" ]; then
	rc="$config/openbox/rc.xml"
fi

xsettings_conf="$data/xsettingsd.conf"
if [ -f "$config/xsettingsd.conf" ]; then
	xsettings_conf="$config/xsettingsd.conf"
fi

# XDG_CONFIG_DIRS must be imported too: host Chrome/Firefox open downloads via
# xdg-open, which only finds /etc/xdg/fosos-desktop/mimeapps.list when this is set.
activation_env="DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP DESKTOP_SESSION XDG_CONFIG_DIRS GTK_THEME GTK_ICON_THEME_NAME GTK_USE_PORTAL"
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
	# shellcheck disable=SC2086
	dbus-update-activation-environment --systemd $activation_env >/dev/null 2>&1 || true
fi

# OS keyring (Secret Service) for Cursor/Electron, nm-applet, and libsecret clients.
# PAM (libpam-gnome-keyring) unlocks the login keyring when the user signs in;
# --start initializes the session daemon and exports socket variables.
if command -v gnome-keyring-daemon >/dev/null 2>&1; then
	# shellcheck disable=SC2046
	eval $(gnome-keyring-daemon --start --components=pkcs11,secrets,ssh 2>/dev/null) || true
	export SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-}"
	if [ -n "${GNOME_KEYRING_CONTROL:-}" ]; then
		export GNOME_KEYRING_CONTROL
	fi
	if command -v dbus-update-activation-environment >/dev/null 2>&1; then
		dbus-update-activation-environment --systemd \
			DISPLAY XAUTHORITY SSH_AUTH_SOCK GNOME_KEYRING_CONTROL \
			>/dev/null 2>&1 || true
	fi
fi

# Lightweight XSETTINGS (theme, icons, fonts) without xfsettingsd.
if command -v xsettingsd >/dev/null 2>&1 && [ -f "$xsettings_conf" ]; then
	xsettingsd -c "$xsettings_conf" >/dev/null 2>&1 &
fi

# Regional format for this session and child apps (Settings → Region).
region_file="${XDG_CONFIG_HOME:-$HOME/.config}/fosos-desktop/region"
if [ -f "$region_file" ]; then
	region_locale=$(sed -n 's/^locale=//p' "$region_file" | head -n1)
	if [ -n "$region_locale" ]; then
		export LANG="$region_locale"
		unset LC_ALL
	fi
fi

# Restore keyboard, mouse and idle blanking saved by fosos-settings.
if command -v python3 >/dev/null 2>&1; then
	PYTHONPATH="/usr/lib/fosos-desktop${PYTHONPATH:+:$PYTHONPATH}" \
		python3 -c 'from fosdesk.settings_pages import restore_session_input; restore_session_input()' \
		>/dev/null 2>&1 || true
fi

# An authentication agent for pkexec and other password prompts.
for agent in \
	/usr/bin/lxpolkit \
	/usr/libexec/polkit-mate-authentication-agent-1 \
	/usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 \
	/usr/libexec/xfce-polkit \
	/usr/lib/x86_64-linux-gnu/ukui-polkit/polkit-ukui-authentication-agent-1; do
	if [ -x "$agent" ]; then
		"$agent" >/dev/null 2>&1 &
		break
	fi
done

# Super alone opens Start (tap Super → Alt+F1). Super+key chords still work.
if command -v xcape >/dev/null 2>&1; then
	pkill -u "$(id -u)" -x xcape >/dev/null 2>&1 || true
	xcape -e 'Super_L=Alt_L|F1;Super_R=Alt_L|F1' >/dev/null 2>&1 &
fi

# Lock on idle, lid close and before suspend. Super+L and Start > Lock also
# run fosos-lock directly. Idle timeout comes from Settings → Power (restored
# above); fall back to 5 minutes when no power prefs exist yet.
if command -v xss-lock >/dev/null 2>&1 && command -v fosos-lock >/dev/null 2>&1; then
	if [ ! -f "$config/power" ]; then
		xset s 300 5 >/dev/null 2>&1 || true
	fi
	xss-lock -l --transfer-sleep-lock -- fosos-lock >/dev/null 2>&1 &
fi

# Browser Save As. D-Bus also starts it if a download begins first.
if [ -x /usr/bin/fosos-file-chooser ]; then
	/usr/bin/fosos-file-chooser >/dev/null 2>&1 &
fi

# XDG autostart (Task Manager → Startup apps): nm-applet, blueman, Welcome, …
# Skips session plumbing already started above. Enable/disable is per-user under
# ~/.config/autostart.
if command -v python3 >/dev/null 2>&1; then
	PYTHONPATH="/usr/lib/fosos-desktop${PYTHONPATH:+:$PYTHONPATH}" \
		python3 -c 'from fosdesk.taskmgr import run_session_autostart; run_session_autostart()' \
		>/dev/null 2>&1 || true
fi

open_recovery_terminal() {
	date -u +"%Y-%m-%dT%H:%M:%SZ shell gave up after repeated crashes" >"$config/shell-failed"
	if command -v fosos-terminal >/dev/null 2>&1; then
		fosos-terminal -e /usr/libexec/fosos-shell-recovery >/dev/null 2>&1 &
		return
	fi
	if command -v xterm >/dev/null 2>&1; then
		xterm -T "FosOS recovery" -e /usr/libexec/fosos-shell-recovery >/dev/null 2>&1 &
	fi
}

# Restart the shell if it crashes, but give up after repeated failures so a
# broken package cannot loop forever. The window manager keeps running and a
# recovery terminal is opened so the user can use Recovery or restart the shell.
(
	failures=0
	: >"$config/shell.log"
	while [ "$failures" -lt 5 ]; do
		started=$(date +%s)
		echo "--- $(date -u +"%Y-%m-%dT%H:%M:%SZ") starting fosos-shell ---" >>"$config/shell.log"
		fosos-shell >>"$config/shell.log" 2>&1
		status=$?
		echo "--- $(date -u +"%Y-%m-%dT%H:%M:%SZ") fosos-shell exited $status ---" >>"$config/shell.log"
		if [ "$status" -eq 0 ]; then
			rm -f "$config/shell-failed"
			break
		fi
		if [ $(($(date +%s) - started)) -gt 60 ]; then
			failures=0
		fi
		failures=$((failures + 1))
		sleep 1
	done
	if [ "$failures" -ge 5 ]; then
		open_recovery_terminal
	fi
) &
shell_loop=$!

# Fallback root colour if the shell desktop window is slow or missing.
if command -v xsetroot >/dev/null 2>&1; then
	xsetroot -solid "#0a0a0a" >/dev/null 2>&1 || true
fi

openbox --config-file "$rc"
status=$?

kill "$shell_loop" 2>/dev/null || true
pkill -u "$(id -u)" -x fosos-shell 2>/dev/null || true
pkill -u "$(id -u)" -x fosos-lock 2>/dev/null || true
pkill -u "$(id -u)" -x xss-lock 2>/dev/null || true
pkill -u "$(id -u)" -x xsettingsd 2>/dev/null || true
pkill -u "$(id -u)" -x xcape 2>/dev/null || true
pkill -u "$(id -u)" -x blueman-applet 2>/dev/null || true
pkill -u "$(id -u)" -x blueman-tray 2>/dev/null || true
pkill -u "$(id -u)" -x nm-applet 2>/dev/null || true
pkill -u "$(id -u)" -f '/usr/bin/fosos-file-chooser' 2>/dev/null || true
if command -v systemctl >/dev/null 2>&1; then
	systemctl --user unset-environment XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP DESKTOP_SESSION XDG_CONFIG_DIRS GTK_THEME GTK_ICON_THEME_NAME GTK_USE_PORTAL \
		>/dev/null 2>&1 || true
fi
exit "$status"
