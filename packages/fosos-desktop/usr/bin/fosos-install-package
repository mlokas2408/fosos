#!/usr/bin/python3
"""Install a local .deb package on FosOS Desktop."""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "fosos-desktop"))

from fosdesk.installpkg import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
