# FosOS window frames for Openbox: flat, square, neutral dark.
# Openbox draws its built-in button shapes, since no bitmaps are provided.

border.width: 1
padding.width: 8
padding.height: 6
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
menu.overlap.x: 0
menu.overlap.y: 0
menu.separator.width: 1
menu.separator.padding.width: 6
menu.separator.padding.height: 3

window.active.border.color: #333333
window.inactive.border.color: #262626
window.active.client.color: #171717
window.inactive.client.color: #171717
window.active.title.separator.color: #262626
window.inactive.title.separator.color: #1f1f1f

window.active.title.bg: flat solid
window.active.title.bg.color: #171717
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #0f0f0f

window.active.label.bg: parentrelative
window.active.label.text.color: #fafafa
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #a1a1a1
window.label.text.justify: left

window.active.handle.bg: flat solid
window.active.handle.bg.color: #171717
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #0f0f0f
window.active.grip.bg: flat solid
window.active.grip.bg.color: #171717
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #0f0f0f

window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #fafafa
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #262626
window.active.button.hover.image.color: #fafafa
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #333333
window.active.button.pressed.image.color: #fafafa
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #525252
window.active.button.toggled.unpressed.bg: parentrelative
window.active.button.toggled.unpressed.image.color: #fafafa

window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #737373
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #262626
window.inactive.button.hover.image.color: #fafafa
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #333333
window.inactive.button.pressed.image.color: #fafafa
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #404040
window.inactive.button.toggled.unpressed.bg: parentrelative
window.inactive.button.toggled.unpressed.image.color: #737373

menu.border.color: #333333
menu.title.bg: flat solid
menu.title.bg.color: #171717
menu.title.text.color: #a1a1a1
menu.title.text.justify: left
menu.items.bg: flat solid
menu.items.bg.color: #171717
menu.items.text.color: #fafafa
menu.items.disabled.text.color: #525252
menu.items.active.bg: flat solid
menu.items.active.bg.color: #262626
menu.items.active.text.color: #fafafa
menu.separator.color: #262626

osd.border.color: #333333
osd.bg: flat solid
osd.bg.color: #171717
osd.label.bg: parentrelative
osd.label.text.color: #fafafa
osd.hilight.bg: flat solid
osd.hilight.bg.color: #e5e5e5
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #262626
osd.button.unpressed.bg: flat solid
osd.button.unpressed.bg.color: #171717
osd.button.unpressed.*.border.color: #333333
osd.button.pressed.bg: flat solid
osd.button.pressed.bg.color: #262626
osd.button.focused.bg: flat solid
osd.button.focused.bg.color: #262626
osd.button.focused.*.border.color: #737373
