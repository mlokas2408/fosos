# FosOS window frames for Openbox: flat, square, mockup palette.
# Button masks (close/max/iconify.xbm) match the mockup line icons.
# Borders use palette greys with enough contrast that stacked windows
# stay readable (Windows-like frame clarity without leaving Dawn colours).

# Visible frame and the mouse-resize grab. Openbox has no separate hit
# target, so 1px cannot be pulled. The titlebar's top grip is separate
# (padding.height + 1).
border.width: 5
padding.width: 8
# Vertical padding around title text — total chrome ~30px like Cursor.
# height ≈ 2*padding.height + button (16) → ~30 with padding.height 7.
padding.height: 7
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
menu.overlap.x: 0
menu.overlap.y: 0
menu.separator.width: 1
menu.separator.padding.width: 6
menu.separator.padding.height: 3

# Active = fos_frame (#737373); inactive = fos_frame_inactive (#404040).
window.active.border.color: #737373
window.inactive.border.color: #404040
window.active.client.color: #171717
window.inactive.client.color: #171717
window.active.title.separator.color: #404040
window.inactive.title.separator.color: #2a2a2a

# Active titlebar is muted, like the mockup header.
window.active.title.bg: flat solid
window.active.title.bg.color: #1f1f1f
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #141414

window.active.label.bg: parentrelative
window.active.label.text.color: #fafafa
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #a1a1a1
