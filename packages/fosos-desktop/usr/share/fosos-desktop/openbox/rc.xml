<?xml version="1.0" encoding="UTF-8"?>
<!-- FosOS Desktop window manager settings. Copy this file to
     ~/.config/fosos-desktop/openbox/rc.xml to change it for one account. -->
<openbox_config xmlns="http://openbox.org/3.4/rc" xmlns:xi="http://www.w3.org/2001/XInclude">
  <resistance>
    <strength>10</strength>
    <screen_edge_strength>20</screen_edge_strength>
  </resistance>

  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
    <underMouse>no</underMouse>
    <focusDelay>200</focusDelay>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <placement>
    <policy>Smart</policy>
    <center>yes</center>
    <monitor>Primary</monitor>
    <primaryMonitor>1</primaryMonitor>
  </placement>

  <theme>
    <name>FosOS</name>
    <!-- No window icon (N): apps ship colored icons; FosOS stays monochrome. -->
    <titleLayout>LIMC</titleLayout>
    <!-- No frame when maximized — same idea as Windows. -->
    <keepBorder>no</keepBorder>
    <animateIconify>no</animateIconify>
    <font place="ActiveWindow">
      <name>Inter</name>
      <size>11</size>
      <weight>Normal</weight>
      <slant>Normal</slant>
    </font>
    <font place="InactiveWindow">
      <name>Inter</name>
      <size>11</size>
      <weight>Normal</weight>
      <slant>Normal</slant>
    </font>
    <font place="MenuHeader">
      <name>Inter</name>
      <size>11</size>
      <weight>Bold</weight>
      <slant>Normal</slant>
    </font>
    <font place="MenuItem">
      <name>Inter</name>
      <size>11</size>
      <weight>Normal</weight>
      <slant>Normal</slant>
    </font>
    <font place="ActiveOnScreenDisplay">
      <name>Inter</name>
      <size>11</size>
      <weight>Bold</weight>
      <slant>Normal</slant>
    </font>
    <font place="InactiveOnScreenDisplay">
      <name>Inter</name>
      <size>11</size>
      <weight>Normal</weight>
      <slant>Normal</slant>
    </font>
  </theme>

  <desktops>
    <number>4</number>
    <firstdesk>1</firstdesk>
    <names>
      <name>Desktop 1</name>
      <name>Desktop 2</name>
      <name>Desktop 3</name>
      <name>Desktop 4</name>
    </names>
    <popupTime>0</popupTime>
  </desktops>

  <resize>
    <drawContents>yes</drawContents>
    <popupShow>Nonpixel</popupShow>
    <popupPosition>Center</popupPosition>
  </resize>

  <margins>
    <top>0</top>
    <bottom>0</bottom>
    <left>0</left>
    <right>0</right>
  </margins>

  <keyboard>
    <chainQuitKey>C-g</chainQuitKey>

    <!-- Start: Super alone via xcape → Alt+F1; Super+Space remains an alias. -->
    <keybind key="W-space">
      <action name="Execute"><command>fosos-shell --toggle-start</command></action>
    </keybind>
    <keybind key="A-F1">
      <action name="Execute"><command>fosos-shell --toggle-start</command></action>
    </keybind>

    <keybind key="W-e">
      <action name="Execute"><command>fosos-files</command></action>
    </keybind>
    <keybind key="C-A-t">
      <action name="Execute"><command>fosos-terminal</command></action>
    </keybind>
    <keybind key="W-i">
      <action name="Execute"><command>fosos-settings</command></action>
    </keybind>
    <keybind key="W-l">
      <action name="Execute"><command>fosos-lock</command></action>
    </keybind>
    <keybind key="W-r">
      <action name="Execute"><command>fosos-shell --run</command></action>
    </keybind>
    <keybind key="W-x">
      <action name="Execute"><command>fosos-shell --quick-links</command></action>
    </keybind>
    <keybind key="W-a">
      <action name="Execute"><command>fosos-shell --quick-settings</command></action>
    </keybind>
    <keybind key="W-n">
      <action name="Execute"><command>fosos-shell --notification-center</command></action>
    </keybind>
    <keybind key="W-v">
      <action name="Execute"><command>fosos-shell --clipboard-history</command></action>
    </keybind>
    <keybind key="Print">
      <action name="Execute"><command>fosos-screenshot -f</command></action>
    </keybind>
    <keybind key="S-Print">
      <action name="Execute"><command>fosos-screenshot -r</command></action>
    </keybind>
    <keybind key="W-S-s">
      <action name="Execute"><command>fosos-screenshot -r</command></action>
    </keybind>

    <keybind key="W-1">
      <action name="GoToDesktop"><to>1</to></action>
    </keybind>
    <keybind key="W-2">
      <action name="GoToDesktop"><to>2</to></action>
    </keybind>
    <keybind key="W-3">
      <action name="GoToDesktop"><to>3</to></action>
    </keybind>
    <keybind key="W-4">
      <action name="GoToDesktop"><to>4</to></action>
    </keybind>
    <keybind key="C-A-Left">
      <action name="GoToDesktop"><to>left</to><wrap>no</wrap></action>
    </keybind>
    <keybind key="C-A-Right">
      <action name="GoToDesktop"><to>right</to><wrap>no</wrap></action>
    </keybind>
    <keybind key="C-W-Left">
      <action name="GoToDesktop"><to>left</to><wrap>no</wrap></action>
    </keybind>
    <keybind key="C-W-Right">
      <action name="GoToDesktop"><to>right</to><wrap>no</wrap></action>
    </keybind>
    <keybind key="W-S-Left">
      <action name="SendToDesktop"><to>left</to><wrap>no</wrap></action>
    </keybind>
    <keybind key="W-S-Right">
      <action name="SendToDesktop"><to>right</to><wrap>no</wrap></action>
    </keybind>
    <keybind key="W-S-1">
      <action name="SendToDesktop"><to>1</to></action>
    </keybind>
    <keybind key="W-S-2">
      <action name="SendToDesktop"><to>2</to></action>
    </keybind>
    <keybind key="W-S-3">
      <action name="SendToDesktop"><to>3</to></action>
    </keybind>
    <keybind key="W-S-4">
      <action name="SendToDesktop"><to>4</to></action>
    </keybind>

    <keybind key="A-Tab">
      <action name="Execute"><command>fosos-shell --alt-tab next</command></action>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="Execute"><command>fosos-shell --alt-tab prev</command></action>
    </keybind>
    <keybind key="W-Tab">
      <action name="Execute"><command>fosos-shell --task-view</command></action>
    </keybind>
    <keybind key="W-z">
      <action name="Execute"><command>fosos-shell --snap-layouts</command></action>
    </keybind>
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>
    <keybind key="W-d">
      <action name="ToggleShowDesktop"/>
    </keybind>
    <keybind key="W-Up">
      <action name="Execute"><command>fosos-shell --snap-maximize</command></action>
    </keybind>
    <keybind key="W-Down">
      <action name="Execute"><command>fosos-shell --snap-down</command></action>
    </keybind>
    <keybind key="W-Left">
      <action name="Execute"><command>fosos-shell --snap-left</command></action>
    </keybind>
    <keybind key="W-Right">
      <action name="Execute"><command>fosos-shell --snap-right</command></action>
    </keybind>
    <keybind key="A-space">
      <action name="ShowMenu"><menu>client-menu</menu></action>
    </keybind>
  </keyboard>

  <mouse>
    <dragThreshold>4</dragThreshold>
    <doubleClickTime>400</doubleClickTime>
    <screenEdgeWarpTime>0</screenEdgeWarpTime>
    <screenEdgeWarpMouse>false</screenEdgeWarpMouse>

    <context name="Frame">
      <mousebind button="A-Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="A-Left" action="Drag">
        <action name="Move"/>
      </mousebind>
      <mousebind button="A-Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="A-Right" action="Drag">
        <action name="Resize"/>
      </mousebind>
    </context>

    <context name="Titlebar">
      <!-- Drag to the top edge maximizes via fosos-shell EdgeSnap; Openbox
           unmaximizes when a maximized titlebar is dragged. -->
      <mousebind button="Left" action="Drag">
        <action name="Move"/>
      </mousebind>
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize"/>
      </mousebind>
    </context>

    <context name="Titlebar Top Right Bottom Left TLCorner TRCorner BRCorner BLCorner">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Unshade"/>
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="Lower"/>
        <action name="FocusToBottom"/>
        <action name="Unfocus"/>
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="ShowMenu"><menu>client-menu</menu></action>
      </mousebind>
    </context>

    <context name="Top">
      <mousebind button="Left" action="Drag">
        <action name="Resize"><edge>top</edge></action>
      </mousebind>
    </context>
    <context name="Left">
      <mousebind button="Left" action="Drag">
        <action name="Resize"><edge>left</edge></action>
      </mousebind>
    </context>
    <context name="Right">
      <mousebind button="Left" action="Drag">
        <action name="Resize"><edge>right</edge></action>
      </mousebind>
    </context>
    <context name="Bottom">
      <mousebind button="Left" action="Drag">
        <action name="Resize"><edge>bottom</edge></action>
      </mousebind>
    </context>
    <context name="TRCorner BRCorner TLCorner BLCorner">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Unshade"/>
      </mousebind>
      <mousebind button="Left" action="Drag">
        <action name="Resize"/>
      </mousebind>
    </context>

    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
    </context>

    <context name="Icon">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Unshade"/>
        <action name="ShowMenu"><menu>client-menu</menu></action>
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="ShowMenu"><menu>client-menu</menu></action>
      </mousebind>
    </context>

    <context name="Iconify">
      <mousebind button="Left" action="Click">
        <action name="Iconify"/>
      </mousebind>
    </context>
    <context name="Maximize">
      <!-- Left click toggles maximize; right click opens FosOS snap layouts
           (Openbox has no hover action for the maximize button). -->
      <mousebind button="Left" action="Click">
        <action name="ToggleMaximize"/>
      </mousebind>
      <mousebind button="Right" action="Click">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Execute"><command>fosos-shell --snap-layouts</command></action>
      </mousebind>
    </context>
    <context name="Close">
      <mousebind button="Left" action="Click">
        <action name="Close"/>
      </mousebind>
    </context>
  </mouse>

  <menu>
    <file>/usr/share/fosos-desktop/openbox/menu.xml</file>
    <hideDelay>200</hideDelay>
    <middle>no</middle>
    <submenuShowDelay>100</submenuShowDelay>
    <submenuHideDelay>400</submenuHideDelay>
    <showIcons>yes</showIcons>
    <manageDesktops>no</manageDesktops>
  </menu>

  <applications>
    <!-- force=yes: GTK sets program-specified location 0,0 which otherwise
         sticks new windows in the top-left corner. -->
    <application class="Fosos-settings">
      <position force="yes"><x>center</x><y>center</y></position>
    </application>
    <application class="Fosos-files">
      <decor>no</decor>
      <position force="yes"><x>center</x><y>center</y></position>
    </application>
    <application class="Fosos-terminal">
      <decor>no</decor>
      <position force="yes"><x>center</x><y>center</y></position>
    </application>
    <application class="Fosos-notepad">
      <decor>no</decor>
      <position force="yes"><x>center</x><y>center</y></position>
    </application>
    <application class="Fosos-remote">
      <decor>no</decor>
      <position force="yes"><x>center</x><y>center</y></position>
    </application>
  </applications>
</openbox_config>
