[Icon Theme]
Name=FosOS
Comment=Sharp geometric icons for FosOS Desktop
Inherits=Adwaita,hicolor
Directories=scalable/places,scalable/mimetypes,scalable/apps,scalable/actions,scalable/status,scalable/devices
Example=folder

[scalable/places]
Size=16
Type=Scalable
MinSize=8
MaxSize=512
Context=Places

[scalable/mimetypes]
Size=16
Type=Scalable
MinSize=8
MaxSize=512
Context=MimeTypes

[scalable/apps]
Size=16
Type=Scalable
MinSize=8
MaxSize=512
Context=Applications

[scalable/actions]
Size=16
Type=Scalable
MinSize=8
MaxSize=512
Context=Actions

[scalable/status]
Size=16
Type=Scalable
MinSize=8
MaxSize=512
Context=Status

[scalable/devices]
Size=16
Type=Scalable
MinSize=8
MaxSize=512
Context=Devices
