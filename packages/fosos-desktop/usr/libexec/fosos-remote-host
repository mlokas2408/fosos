#!/bin/sh
# Enable, disable, or report FosOS Remote Desktop hosting (xrdp).
# Intended for pkexec. Starts a separate FosOS Desktop session for any
# local Unix user — does not share the console (not FreeRDP shadow).

MARKER=/var/lib/fosos/remote-desktop-enabled
INFOFILE=/run/fosos/rdp-host-info
# Legacy path from 1.5.x shadow host — remove on enable/disable.
LEGACY_INFO=/run/fosos/rdp-shadow-info
LEGACY_ENV=/run/fosos/rdp-shadow.env
LEGACY_UNIT=fosos-rdp-shadow.service
RDPFILE_NAME=FosOS-Remote-Desktop.rdp
TEMPLATE_DIR=/usr/share/fosos-desktop/xrdp
XRDP_DIR=/etc/xrdp
BACKUP_DIR=/etc/xrdp/fosos-stock-backup
UNIT_XRDP=xrdp.service
UNIT_SESMAN=xrdp-sesman.service
ACTION="${1:-}"

is_active() {
	systemctl is-active --quiet "$UNIT_XRDP" 2>/dev/null \
		&& systemctl is-active --quiet "$UNIT_SESMAN" 2>/dev/null
}

listening() {
	if command -v ss >/dev/null 2>&1; then
		ss -ltn 2>/dev/null | grep -Eq '[:.]3389\s'
		return $?
	fi
	return 0
}

wait_ready() {
	i=0
	while [ "$i" -lt 40 ]; do
		if is_active && listening; then
			return 0
		fi
		if [ "$i" -ge 24 ] && is_active; then
			return 0
		fi
		sleep 0.25
		i=$((i + 1))
	done
	return 1
}

xrdp_installed() {
	command -v xrdp >/dev/null 2>&1 \
		|| [ -x /usr/sbin/xrdp ] \
		|| [ -f /lib/systemd/system/xrdp.service ] \
		|| [ -f /usr/lib/systemd/system/xrdp.service ]
}

primary_ip() {
	hostname -I 2>/dev/null | awk '{print $1; exit}'
}

find_desktop_user() {
	# Prefer the user who invoked pkexec, then an active local session.
	if [ -n "${PKEXEC_UID:-}" ]; then
		name=$(getent passwd "$PKEXEC_UID" | cut -d: -f1)
		if [ -n "$name" ]; then
			printf '%s\n' "$name"
			return 0
		fi
	fi
	if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
		printf '%s\n' "$SUDO_USER"
		return 0
	fi
	if command -v loginctl >/dev/null 2>&1; then
		for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
			[ -n "$sid" ] || continue
			class=$(loginctl show-session "$sid" -p Class --value 2>/dev/null || true)
			[ "$class" = "user" ] || continue
			remote=$(loginctl show-session "$sid" -p Remote --value 2>/dev/null || true)
			[ "$remote" = "yes" ] && continue
			name=$(loginctl show-session "$sid" -p Name --value 2>/dev/null || true)
			[ -n "$name" ] || continue
			printf '%s\n' "$name"
			return 0
		done
	fi
	return 1
}

write_rdp_file() {
	user=$1
	home=$2
	ip=$(primary_ip)
	[ -n "$ip" ] || ip=$(hostname -f 2>/dev/null || hostname)
	w=1920
	h=1080

	desktop="$home/Desktop"
	mkdir -p "$desktop" 2>/dev/null || true
	path="$desktop/$RDPFILE_NAME"
	# Username left blank so mstsc prompts; any local FosOS account works.
	cat >"$path" <<EOF
screen mode id:i:2
use multimon:i:0
desktopwidth:i:$w
desktopheight:i:$h
session bpp:i:32
winposstr:s:0,1,0,0,${w},${h}
compression:i:1
keyboardhook:i:2
audiocapturemode:i:0
videoplaybackmode:i:1
connection type:i:7
networkautodetect:i:1
bandwidthautodetect:i:1
displayconnectionbar:i:1
username:s:
full address:s:${ip}:3389
audiomode:i:0
redirectprinters:i:0
redirectcomports:i:0
redirectsmartcards:i:0
redirectclipboard:i:1
redirectposdevices:i:0
autoreconnection enabled:i:1
authentication level:i:2
prompt for credentials:i:1
negotiate security layer:i:1
remoteapplicationmode:i:0
smart sizing:i:1
dynamic resolution:i:1
allow font smoothing:i:1
allow desktop composition:i:1
EOF
	if [ -n "$user" ]; then
		chown "$user": "$(id -gn "$user" 2>/dev/null || echo "$user")" "$path" 2>/dev/null || true
	fi
	chmod 644 "$path" 2>/dev/null || true
}

write_info() {
	mkdir -p /run/fosos
	chmod 755 /run/fosos 2>/dev/null || true
	ip=$(primary_ip)
	{
		echo "mode=session"
		echo "port=3389"
		echo "backend=xrdp"
		echo "security=negotiate"
		[ -n "$ip" ] && echo "address=$ip"
	} >"$INFOFILE" 2>/dev/null || true
	chmod 644 "$INFOFILE" 2>/dev/null || true
}

backup_stock() {
	mkdir -p "$BACKUP_DIR"
	for name in xrdp.ini sesman.ini startwm.sh; do
		src="$XRDP_DIR/$name"
		dst="$BACKUP_DIR/$name"
		if [ -e "$src" ] && [ ! -e "$dst" ]; then
			cp -a "$src" "$dst" 2>/dev/null || true
		fi
	done
}

apply_config() {
	if [ ! -d "$TEMPLATE_DIR" ]; then
		echo "FosOS xrdp templates missing at $TEMPLATE_DIR" >&2
		return 1
	fi
	mkdir -p "$XRDP_DIR"
	backup_stock
	# Branding assets stay under /usr/share; configs land in /etc/xrdp.
	cp -a "$TEMPLATE_DIR/xrdp.ini" "$XRDP_DIR/xrdp.ini"
	cp -a "$TEMPLATE_DIR/sesman.ini" "$XRDP_DIR/sesman.ini"
	cp -a "$TEMPLATE_DIR/startwm.sh" "$XRDP_DIR/startwm.sh"
	chmod 644 "$XRDP_DIR/xrdp.ini" "$XRDP_DIR/sesman.ini" 2>/dev/null || true
	chmod 755 "$XRDP_DIR/startwm.sh" 2>/dev/null || true
	# Ensure TLS material exists (xrdp creates on first start if missing).
	if [ ! -f "$XRDP_DIR/cert.pem" ] || [ ! -f "$XRDP_DIR/key.pem" ]; then
		if command -v openssl >/dev/null 2>&1; then
			openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
				-subj "/CN=$(hostname -f 2>/dev/null || hostname)/O=FosOS" \
				-keyout "$XRDP_DIR/key.pem" \
				-out "$XRDP_DIR/cert.pem" >/dev/null 2>&1 || true
			chmod 640 "$XRDP_DIR/key.pem" 2>/dev/null || true
			chmod 644 "$XRDP_DIR/cert.pem" 2>/dev/null || true
			if getent group xrdp >/dev/null 2>&1; then
				chown root:xrdp "$XRDP_DIR/key.pem" "$XRDP_DIR/cert.pem" 2>/dev/null || true
			fi
		fi
	fi
	return 0
}

stop_legacy_shadow() {
	systemctl disable --now "$LEGACY_UNIT" >/dev/null 2>&1 || true
	rm -f "$LEGACY_ENV" "$LEGACY_INFO"
	rm -f /etc/systemd/system/fosos-rdp-shadow.service.d/override.conf
	rmdir /etc/systemd/system/fosos-rdp-shadow.service.d 2>/dev/null || true
}

case "$ACTION" in
apply-config)
	apply_config || exit 1
	echo "applied"
	;;
enable)
	if ! xrdp_installed; then
		echo "xrdp is not installed (package xrdp)" >&2
		exit 1
	fi
	if ! command -v systemctl >/dev/null 2>&1; then
		echo "systemd is required" >&2
		exit 1
	fi
	stop_legacy_shadow
	apply_config || exit 1
	mkdir -p /var/lib/fosos
	touch "$MARKER"
	# Open RDP through the host firewall when UFW is active.
	if command -v ufw >/dev/null 2>&1; then
		ufw allow 3389/tcp comment 'FosOS Remote Desktop' >/dev/null 2>&1 || true
	fi
	systemctl enable "$UNIT_SESMAN" >/dev/null 2>&1 || true
	systemctl enable "$UNIT_XRDP" >/dev/null 2>&1 || true
	systemctl restart "$UNIT_SESMAN" >/dev/null 2>&1 \
		|| systemctl start "$UNIT_SESMAN" >/dev/null 2>&1 || true
	systemctl restart "$UNIT_XRDP" >/dev/null 2>&1 \
		|| systemctl start "$UNIT_XRDP" >/dev/null 2>&1 || true
	if wait_ready; then
		write_info
		user=$(find_desktop_user || true)
		if [ -n "$user" ]; then
			home=$(getent passwd "$user" | cut -d: -f6)
			if [ -n "$home" ] && [ -d "$home" ]; then
				write_rdp_file "$user" "$home"
			fi
		fi
		echo "enabled"
		exit 0
	fi
	rm -f "$MARKER"
	echo "Remote Desktop (xrdp) did not become ready (check journalctl -u $UNIT_XRDP)" >&2
	exit 1
	;;
disable)
	rm -f "$MARKER"
	stop_legacy_shadow
	systemctl stop "$UNIT_XRDP" >/dev/null 2>&1 || true
	systemctl stop "$UNIT_SESMAN" >/dev/null 2>&1 || true
	systemctl disable "$UNIT_XRDP" >/dev/null 2>&1 || true
	systemctl disable "$UNIT_SESMAN" >/dev/null 2>&1 || true
	rm -f "$INFOFILE"
	if command -v ufw >/dev/null 2>&1; then
		ufw --force delete allow 3389/tcp >/dev/null 2>&1 || true
	fi
	systemctl daemon-reload >/dev/null 2>&1 || true
	echo "disabled"
	;;
status)
	if is_active; then
		echo "active"
		exit 0
	fi
	echo "inactive"
	exit 1
	;;
*)
	echo "usage: fosos-remote-host enable|disable|status|apply-config" >&2
	exit 2
	;;
esac
